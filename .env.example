# CREADO: ejemplo sin credenciales reales. Mantener .env fuera de Git.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Desarrollo local. Cambiar la contraseña en ambos lugares antes de iniciar Docker.
